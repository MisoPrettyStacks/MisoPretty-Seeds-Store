# Server configuration
PORT=5000

# Stripe (test mode while building)
# Get test keys at https://dashboard.stripe.com/test/apikeys
# NEVER commit real keys. The secret key is only used on the server.
STRIPE_SECRET_KEY=sk_test_YOUR_TEST_SECRET_KEY

# The publishable key is documented here for reference; the frontend does
# not use it directly because checkout happens on Stripe's hosted page.
# When you go live, replace BOTH keys with your live keys (sk_live_... and
# pk_live_...) and make sure "Test mode" is OFF in the Stripe dashboard.
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_TEST_PUBLISHABLE_KEY
